# ========================================
# 1. ENVIRONMENTS & SECRETS
# ========================================
.venv/
env/
venv/
.env
.env.*
!.env.example
*.pem
*.key

# ========================================
# 2. PYTHON CACHE & TOOLING
# ========================================
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.mypy_cache/

# ========================================
# 3. GO (API) CACHE & BUILD ARTIFACTS
# ========================================
vendor/
bin/
*.exe
*.test
*.out

# ========================================
# 4. RUST (VALIDATOR)
# ========================================
/src/validator/target/
**/*.rs.bk

# ========================================
# 5. DATA & ML ARTIFACTS
# ========================================
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

models/*
!models/*.onnx
!models/*.joblib
!models/.gitkeep

# ========================================
# 6. INFRASTRUCTURE (TF, HELM, INFRACOST)
# ========================================
# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Helm
**/charts/
*.tgz

# Infracost
.infracost/

# ========================================
# 7. LOGS, TESTING & JUPYTER
# ========================================
logs/*.log
!logs/.gitkeep
*.log
.coverage
.pytest_cache/
htmlcov/
nosetests.xml
coverage.xml
*,cover
.ipynb_checkpoints/

# ========================================
# 8. IDEs, OS & TASKFILE
# ========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
.task/
.docker/
