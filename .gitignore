# Environments
.venv/
env/
venv/

# Python Cache & Tooling
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.mypy_cache/

# Security & Configurations
.env
.env.*
!.env.example

# IDEs & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Taskfile Cache
.task/

# Data (Raw and Processed)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Machine Learning Artifacts
models/*
!models/*.onnx
!models/*.joblib
!models/.gitkeep

# Jupyter/Notebooks
.ipynb_checkpoints/

# Logs
logs/*.log
!logs/.gitkeep
*.log

# Testing & Coverage
.coverage
.pytest_cache/
htmlcov/
nosetests.xml
coverage.xml
*,cover

# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Ignore any .tfvars files that are generated automatically
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Rust
/src/validator/target/
**/*.rs.bk

# Docker
.docker/

# Infracost cache
.infracost/
