package dashboard

import "fmt"

type Transaction struct {
	TransactionID string
	UserID        string
	Amount        float64
	RiskScore     float64
}

templ DashboardPage() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Sentinel AI - Telemetry</title>
			<script src="https://unpkg.com/htmx.org@1.9.11"></script>
			<script src="https://cdn.tailwindcss.com"></script>
		</head>
		<body class="bg-slate-50 text-slate-900 font-sans antialiased">
			<div class="max-w-6xl mx-auto p-6 lg:p-10">
				
				<header class="flex items-center justify-between border-b border-slate-200 pb-6 mb-8">
					<div>
						<h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Sentinel Dashboard</h1>
						<p class="text-sm text-slate-500 mt-1">Real-time AI Fraud Detection Telemetry</p>
					</div>
					<div class="flex items-center gap-3 bg-white border border-slate-200 px-4 py-2 rounded-full shadow-sm">
						<span class="relative flex h-3 w-3">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
							<span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
						</span>
						<span class="text-sm font-semibold text-slate-700 uppercase tracking-wide">System Online</span>
					</div>
				</header>

				<main>
					<div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
						<div class="px-6 py-5 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
							<h2 class="text-base font-semibold text-slate-800">Live Transaction Stream</h2>
						</div>
						<div class="overflow-x-auto">
							<table class="w-full text-left text-sm whitespace-nowrap">
								<thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
									<tr>
										<th class="px-6 py-4 font-semibold">Transaction ID</th>
										<th class="px-6 py-4 font-semibold">User</th>
										<th class="px-6 py-4 font-semibold">Amount</th>
										<th class="px-6 py-4 font-semibold text-right">Risk Assessment</th>
									</tr>
								</thead>
								
								<tbody id="transaction-stream" hx-get="/api/v1/dashboard/stream" hx-trigger="every 2s" hx-swap="innerHTML" class="divide-y divide-slate-100">
									<tr>
										<td colspan="4" class="px-6 py-16 text-center text-slate-400">
											<div class="flex flex-col items-center justify-center space-y-3">
												<span class="font-medium tracking-wide">Awaiting inference data...</span>
											</div>
										</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ TransactionRows(transactions []Transaction) {
	for _, tx := range transactions {
		<tr class="hover:bg-slate-50 transition-colors duration-150">
			<td class="px-6 py-4 font-mono text-slate-600">{ tx.TransactionID }</td>
			<td class="px-6 py-4 text-slate-600">{ tx.UserID }</td>
			<td class="px-6 py-4 font-mono font-semibold text-slate-900">${ fmt.Sprintf("%.2f", tx.Amount) }</td>
			<td class="px-6 py-4 text-right">
				if tx.RiskScore > 80 {
					<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800 border border-red-200">
						{ fmt.Sprintf("FRAUD (%.1f%%)", tx.RiskScore) }
					</span>
				} else if tx.RiskScore > 50 {
					<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
						{ fmt.Sprintf("REVIEW (%.1f%%)", tx.RiskScore) }
					</span>
				} else {
					<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
						{ fmt.Sprintf("SAFE (%.1f%%)", tx.RiskScore) }
					</span>
				}
			</td>
		</tr>
	}
}